{
  "name": "moovn-studio",
  "private": true,
  "version": "0.1.0",
  "license": "GPL-3.0-only",
  "description": "MooVN Studio — Cross-Platform Visual Novel IDE & GitHub Release Portal (TypeScript + Tauri 2 + YAML)",
  "type": "module",
  "scripts": {
    "dev": "vite --port 5173",
    "build": "tsc -b && vite build",
    "test": "node --experimental-strip-types --test tests/*.test.mts",
    "preview": "vite preview --host 127.0.0.1 --port 5173",
    "tauri": "tauri",
    "tauri:dev": "tauri dev",
    "tauri:build": "tauri build",
    "tauri:android:init": "tauri android init",
    "tauri:android:dev": "tauri android dev",
    "tauri:ios:init": "tauri ios init",
    "pretest": "node scripts/check-node-version.mjs",
    "prebuild": "node scripts/sync-tauri-csp.mjs",
    "pretauri:dev": "node scripts/sync-tauri-csp.mjs",
    "pretauri:build": "node scripts/sync-tauri-csp.mjs",
    "test:e2e": "node --experimental-strip-types tests/browser-smoke.mjs",
    "test:p0:e2e": "node --experimental-strip-types tests/browser-p0.mjs",
    "test:assets:e2e": "node --experimental-strip-types tests/browser-asset-export.mjs",
    "test:math-input:e2e": "node --experimental-strip-types tests/browser-math-input.mjs",
    "test:containers:e2e": "node --experimental-strip-types tests/browser-empty-container.mjs",
    "test:formats:e2e": "node --experimental-strip-types tests/browser-formats.mjs"
  },
  "dependencies": {
    "@noble/hashes": "^2.4.0",
    "lucide-react": "^0.468.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "yaml": "^2.6.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@tauri-apps/cli": "^2.2.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "fake-indexeddb": "^6.2.7",
    "playwright-core": "^1.64.1",
    "tailwindcss": "^4.3.3",
    "typescript": "~5.6.2",
    "vite": "^6.0.5"
  },
  "engines": {
    "node": ">=22.6.0"
  }
}
