{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/screenshots/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=604800, stale-while-revalidate=86400"
        }
      ]
    },
    {
      "source": "/images/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=604800, stale-while-revalidate=86400"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/api/rate-limit",
      "destination": "/api/rate-limit.js"
    },
    {
      "source": "/studio",
      "destination": "/studio.html"
    },
    {
      "source": "/studio.html",
      "destination": "/studio.html"
    },
    {
      "source": "/((?!api/|assets/|images/|screenshots/|studio\\.html|.*\\..*).*)",
      "destination": "/index.html"
    }
  ]
}
