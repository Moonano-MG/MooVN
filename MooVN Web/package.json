{
  "name": "moovn-studio",
  "private": true,
  "version": "0.1.0",
  "license": "GPL-3.0-only",
  "description": "MooVN Studio — Cross-Platform Visual Novel IDE & GitHub Release Portal (TypeScript + Tauri 2 + YAML)",
  "type": "module",
  "scripts": {
    "dev": "vite --port 5173",
    "build": "tsc -b && vite build",
    "test": "node --experimental-strip-types --test ../\"MooVN Studio\"/tests/*.test.mts",
    "test:e2e": "node --experimental-strip-types ../\"MooVN Studio\"/tests/browser-smoke.mjs --web",
    "test:branches:e2e": "node --experimental-strip-types ../\"MooVN Studio\"/tests/browser-branch-safety.mjs --web",
    "test:preview-state:e2e": "node --experimental-strip-types ../\"MooVN Studio\"/tests/browser-preview-state.mjs --web",
    "test:read-skip:e2e": "node --experimental-strip-types '../MooVN Studio/tests/browser-read-skip.mjs' --web",
    "test:read-skip-production:e2e": "node --experimental-strip-types '../MooVN Studio/tests/browser-read-skip-production.mjs' --web",
    "test:preview-script:e2e": "node --experimental-strip-types ../\"MooVN Studio\"/tests/browser-preview-script-safety.mjs --web",
    "test:preview-script-execution:e2e": "node --experimental-strip-types ../\"MooVN Studio\"/tests/browser-preview-script-execution.mjs --web",
    "preview": "vite preview --host 127.0.0.1 --port 5173",
    "tauri": "tauri",
    "tauri:dev": "tauri dev",
    "tauri:build": "tauri build",
    "tauri:android:init": "tauri android init",
    "tauri:android:dev": "tauri android dev",
    "tauri:ios:init": "tauri ios init",
    "pretest": "node ../\"MooVN Studio\"/scripts/check-node-version.mjs",
    "test:settings:e2e": "node --experimental-strip-types ../\"MooVN Studio\"/tests/browser-settings-import.mjs --web",
    "test:standalone:e2e": "node --experimental-strip-types ../\"MooVN Studio\"/tests/browser-standalone-saves.mjs",
    "test:preview-audio:e2e": "node --experimental-strip-types ../\"MooVN Studio\"/tests/browser-preview-audio.mjs --web",
    "test:preferences:e2e": "node --experimental-strip-types '../MooVN Studio/tests/browser-editor-preferences.mjs' --web",
    "test:audition:e2e": "node --experimental-strip-types '../MooVN Studio/tests/browser-audio-audition.mjs' --web",
    "test:assets:e2e": "node --experimental-strip-types '../MooVN Studio/tests/browser-asset-export.mjs' --web",
    "test:remote-media:e2e": "node --experimental-strip-types '../MooVN Studio/tests/browser-remote-media.mjs' --web",
    "test:isolated-build": "node tests/isolated-build.mjs"
  },
  "dependencies": {
    "@noble/hashes": "^2.4.0",
    "lucide-react": "^0.468.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "yaml": "^2.6.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@tauri-apps/cli": "^2.2.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "tailwindcss": "^4.3.3",
    "typescript": "~5.6.2",
    "vite": "^6.0.5"
  },
  "engines": {
    "node": ">=22.6.0"
  }
}
